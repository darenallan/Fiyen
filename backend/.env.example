PORT=8090
DATABASE_URL=postgres://fiyen:fiyen_dev_password@localhost:55020/fiyen?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
JWT_SECRET=changez-moi-en-production
JWT_DUREE_MINUTES=30
# Duree de vie du jeton de renouvellement. Le jeton d'acces reste court
# (non revocable) ; c'est celui-ci, revocable en base, qui porte la session.
REFRESH_DUREE_JOURS=30
# Menage des sessions expirees. Un passage a lieu au demarrage, puis a cet
# intervalle. Une valeur <= 0 fait replier sur 24 h plutot que de faire
# tomber le service.
PURGE_INTERVALLE_HEURES=24
POSITION_TTL_SECONDES=30
MASQUAGE_DUREE_HEURES=4
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177
# Jeton d'acces Expo. Utile seulement si la securite push est activee sur
# le tableau de bord EAS : Expo accepte les envois sans authentification
# tant qu'elle ne l'est pas.
EXPO_ACCESS_TOKEN=
